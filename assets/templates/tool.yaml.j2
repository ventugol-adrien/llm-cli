{% set allowed_types = ["google_search", "function"] %}
$schema: "https://json-schema.org/draft/2020-12/schema"
title: Gemini Interactions tool
type: object
required:
  - type
properties:
  type:
    type: string
    enum:
{% for tool_type in allowed_types %}
      - {{ tool_type }}
{% endfor %}
allOf:
  - if:
      properties:
        type:
          const: function
      required:
        - type
    then:
      required:
        - name
        - description
        - parameters
      properties:
        name:
          type: string
          minLength: 1
        description:
          type: string
          minLength: 1
        parameters:
          type: object